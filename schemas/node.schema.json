{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rage.fail/schemas/0.1/node.schema.json",
  "title": "RAGE Node",
  "type": "object",
  "required": ["kind", "node_id", "node_type"],
  "additionalProperties": true,
  "properties": {
    "kind": { "const": "node" },
    "node_id": {
      "type": "string",
      "description": "primary key. MUST follow the node_id grammar in spec/format.md (provider|account|type|native, with | escaped as %7C in components)."
    },
    "node_type": { "type": "string" },
    "provider": { "type": "string" },
    "name": { "type": "string" },
    "scope": { "type": "object", "description": "where the node lives: {account, region|location, project|subscription, global}" },
    "observed_at": { "type": "string", "format": "date-time", "description": "when this node was collected" },
    "attributes": { "type": "object" }
  }
}
