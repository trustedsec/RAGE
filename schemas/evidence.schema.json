{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rage.fail/schemas/0.1/evidence.schema.json",
  "title": "RAGE Evidence",
  "type": "object",
  "required": ["kind", "evidence_id", "content_hash"],
  "additionalProperties": true,
  "properties": {
    "kind": { "const": "evidence" },
    "evidence_id": { "type": "string" },
    "content_hash": { "type": "string" },
    "source": { "type": "string", "description": "the API/collection operation, e.g. azure:role_assignment:list" },
    "status": { "type": "string", "description": "collection outcome: ok/denied/throttled/…" },
    "captured_at": { "type": "string", "format": "date-time" },
    "scope": {},
    "pointer": { "type": "string", "description": "where the raw response lives, if retained" },
    "detail": { "type": "object" }
  }
}
