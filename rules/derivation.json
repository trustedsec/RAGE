{
  "$comment": "RAGE Rules \u2014 how each edge type is DERIVED. nature: explicit (observed from config) | derived (synthesized) | both. conditions: predicates that must hold. providers: the concrete permissions/triggers that realize the edge on each cloud. A conforming RAGE engine uses these to infer edges; notes flag non-equivalences to avoid false edges.",
  "spec_version": "0.1",
  "rules": {
    "Contains": {
      "nature": "explicit"
    },
    "LocatedIn": {
      "nature": "explicit"
    },
    "AttachedTo": {
      "nature": "explicit"
    },
    "MemberOf": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "trigger": [
            "iam group membership",
            "SSO group assignment"
          ]
        },
        "gcp": {
          "trigger": [
            "Google group membership"
          ]
        },
        "azure": {
          "trigger": [
            "Entra group membership (incl. dynamic)"
          ]
        }
      }
    },
    "HasRole": {
      "nature": "explicit"
    },
    "HasPolicy": {
      "nature": "explicit"
    },
    "HasPermission": {
      "nature": "both"
    },
    "CanAssume": {
      "nature": "both",
      "conditions": [
        "trust_relationship",
        "iam_permission",
        "condition_expression",
        "scp_or_org_policy"
      ],
      "providers": {
        "aws": {
          "permissions": [
            "sts:AssumeRole",
            "sts:AssumeRoleWithWebIdentity",
            "sts:AssumeRoleWithSAML"
          ],
          "note": "Requires role trust policy to allow source."
        },
        "gcp": {
          "permissions": [
            "iam.serviceAccounts.getAccessToken",
            "iam.serviceAccounts.getOpenIdToken",
            "iam.serviceAccounts.signJwt"
          ],
          "note": "Short-lived credential minting = de facto assume."
        },
        "azure": {
          "note": "No direct STS analog; approximate via MI assignment / SP credential add. Prefer CanCreateCredentialFor. Do not equate to AWS AssumeRole."
        }
      }
    },
    "CanImpersonate": {
      "nature": "both",
      "providers": {
        "aws": {
          "note": "Rare; usually expressed as CanAssume."
        },
        "gcp": {
          "permissions": [
            "iam.serviceAccounts.getAccessToken",
            "iam.serviceAccounts.implicitDelegation"
          ]
        },
        "azure": {
          "note": "App-only token acquisition where app has app-role/consent."
        }
      }
    },
    "CanFederateAs": {
      "nature": "both",
      "conditions": [
        "trust_relationship",
        "condition_expression"
      ],
      "providers": {
        "aws": {
          "trigger": [
            "OIDC/SAML IdP + role trust (e.g. GitHub Actions, IRSA)"
          ]
        },
        "gcp": {
          "trigger": [
            "Workload Identity Federation pool + SA binding"
          ]
        },
        "azure": {
          "trigger": [
            "Federated credentials on app registration / MI"
          ]
        }
      }
    },
    "CanDelegate": {
      "nature": "both",
      "providers": {
        "gcp": {
          "trigger": [
            "Domain-wide delegation on SA"
          ]
        },
        "azure": {
          "trigger": [
            "Delegated Graph permissions / OBO flow"
          ]
        }
      }
    },
    "CanPassIdentity": {
      "nature": "explicit",
      "conditions": [
        "iam_permission",
        "condition_expression",
        "role_compatibility"
      ],
      "providers": {
        "aws": {
          "permissions": [
            "iam:PassRole"
          ],
          "note": "Scoped by resource + often service condition."
        },
        "gcp": {
          "permissions": [
            "iam.serviceAccounts.actAs"
          ]
        },
        "azure": {
          "note": "Assigning a user-assigned MI / setting SP on a resource; requires Microsoft.ManagedIdentity/.../assign + write on target."
        }
      }
    },
    "CanCreateCredentialFor": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "permissions": [
            "iam:CreateAccessKey",
            "iam:CreateLoginProfile",
            "iam:UpdateLoginProfile"
          ]
        },
        "gcp": {
          "permissions": [
            "iam.serviceAccountKeys.create"
          ]
        },
        "azure": {
          "permissions": [
            "add password/cert to app or SP (Application.ReadWrite / MS Graph)"
          ]
        }
      }
    },
    "CanResetCredential": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "permissions": [
            "iam:UpdateLoginProfile"
          ]
        },
        "gcp": {
          "note": "Workspace admin password reset."
        },
        "azure": {
          "permissions": [
            "Authentication Administrator / reset password (Graph)"
          ]
        }
      }
    },
    "CanModifyTrust": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "permissions": [
            "iam:UpdateAssumeRolePolicy"
          ]
        },
        "gcp": {
          "permissions": [
            "iam.serviceAccounts.setIamPolicy"
          ]
        },
        "azure": {
          "permissions": [
            "update federated credentials / SP owner"
          ]
        }
      }
    },
    "CanModifyPolicy": {
      "nature": "both",
      "providers": {
        "aws": {
          "permissions": [
            "iam:PutUserPolicy",
            "iam:AttachUserPolicy",
            "iam:CreatePolicyVersion",
            "iam:PutRolePolicy",
            "iam:AttachRolePolicy"
          ]
        },
        "gcp": {
          "permissions": [
            "*.setIamPolicy (e.g. resourcemanager.projects.setIamPolicy)"
          ]
        },
        "azure": {
          "permissions": [
            "Microsoft.Authorization/roleAssignments/write"
          ]
        }
      }
    },
    "CanGrantPermission": {
      "nature": "both",
      "providers": {
        "aws": {
          "permissions": [
            "iam:AttachUserPolicy",
            "iam:PutUserPolicy",
            "iam:AddUserToGroup"
          ]
        },
        "gcp": {
          "permissions": [
            "setIamPolicy at project/folder/org"
          ]
        },
        "azure": {
          "permissions": [
            "Microsoft.Authorization/roleAssignments/write",
            "Owner/User Access Administrator role"
          ]
        }
      }
    },
    "CanAddMember": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "permissions": [
            "iam:AddUserToGroup"
          ]
        },
        "gcp": {
          "note": "Workspace group membership admin."
        },
        "azure": {
          "permissions": [
            "group member write (Graph / owner)"
          ]
        }
      }
    },
    "CanRemoveMember": {
      "nature": "explicit"
    },
    "ExecutesAs": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "trigger": [
            "Lambda execution role",
            "EC2 instance profile",
            "ECS task role",
            "Step Functions execution role"
          ]
        },
        "gcp": {
          "trigger": [
            "SA attached to GCE/GCF/Cloud Run",
            "Workflow runtime SA (workflows.serviceAccount)"
          ]
        },
        "azure": {
          "trigger": [
            "Managed identity on VM/Function/Container",
            "Logic App identity"
          ]
        }
      }
    },
    "CanExecuteAs": {
      "nature": "derived"
    },
    "CanModifyCode": {
      "nature": "both",
      "providers": {
        "aws": {
          "permissions": [
            "lambda:UpdateFunctionCode",
            "ecr:PutImage"
          ]
        },
        "gcp": {
          "permissions": [
            "cloudfunctions.functions.update",
            "run.services.update",
            "artifactregistry.repositories.uploadArtifacts",
            "workflows.workflows.update"
          ]
        },
        "azure": {
          "permissions": [
            "Function app deploy / SCM write",
            "AcrPush"
          ]
        }
      }
    },
    "CanModifyConfiguration": {
      "nature": "both",
      "providers": {
        "aws": {
          "permissions": [
            "lambda:UpdateFunctionConfiguration",
            "ecs:RegisterTaskDefinition"
          ]
        },
        "gcp": {
          "permissions": [
            "cloudfunctions.functions.update",
            "compute.instances.setMetadata"
          ]
        },
        "azure": {
          "permissions": [
            "site config write",
            "VM extension write"
          ]
        }
      }
    },
    "CanDeploy": {
      "nature": "explicit"
    },
    "CanCreateWorkloadAs": {
      "nature": "derived"
    },
    "CanAttachIdentity": {
      "nature": "both",
      "providers": {
        "aws": {
          "permissions": [
            "iam:PassRole + ec2:AssociateIamInstanceProfile",
            "ecs:RegisterTaskDefinition"
          ]
        },
        "gcp": {
          "permissions": [
            "compute.instances.setServiceAccount + actAs",
            "workflows.workflows.update + iam.serviceAccounts.actAs"
          ]
        },
        "azure": {
          "permissions": [
            "assign user-assigned MI to resource"
          ]
        }
      }
    },
    "CanExecuteCommand": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "permissions": [
            "ssm:SendCommand",
            "ssm:StartSession",
            "ec2-instance-connect:SendSSHPublicKey"
          ]
        },
        "gcp": {
          "permissions": [
            "compute.instances.setMetadata (SSH keys)",
            "OS Login roles"
          ]
        },
        "azure": {
          "permissions": [
            "Microsoft.Compute/virtualMachines/runCommand/action",
            "VM run-command / RunPowerShellScript extension"
          ]
        }
      }
    },
    "CanExecuteOn": {
      "nature": "derived"
    },
    "CanTrigger": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "trigger": [
            "S3 event",
            "EventBridge rule",
            "SQS/SNS trigger",
            "Step Functions trigger via EventBridge"
          ]
        },
        "gcp": {
          "trigger": [
            "Eventarc trigger to Workflow",
            "Cloud Scheduler job to Workflow"
          ]
        },
        "azure": {
          "trigger": [
            "Service Bus trigger",
            "Event Grid trigger to Logic App"
          ]
        }
      }
    },
    "CanInvoke": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "permissions": [
            "lambda:InvokeFunction"
          ]
        },
        "gcp": {
          "permissions": [
            "cloudfunctions.functions.invoke",
            "run.routes.invoke"
          ]
        },
        "azure": {
          "permissions": [
            "function key / invoke"
          ]
        }
      }
    },
    "CanStart": {
      "nature": "explicit"
    },
    "CanSchedule": {
      "nature": "explicit"
    },
    "CanReadSecret": {
      "nature": "both",
      "conditions": [
        "iam_permission",
        "resource_policy",
        "key_permission"
      ],
      "providers": {
        "aws": {
          "permissions": [
            "secretsmanager:GetSecretValue",
            "ssm:GetParameter (SecureString)"
          ]
        },
        "gcp": {
          "permissions": [
            "secretmanager.versions.access"
          ]
        },
        "azure": {
          "permissions": [
            "Key Vault secret get (data-plane / RBAC)"
          ]
        }
      }
    },
    "CanReadCredential": {
      "nature": "both"
    },
    "CanDecrypt": {
      "nature": "explicit",
      "providers": {
        "aws": {
          "permissions": [
            "kms:Decrypt"
          ]
        },
        "gcp": {
          "permissions": [
            "cloudkms.cryptoKeyVersions.useToDecrypt"
          ]
        },
        "azure": {
          "permissions": [
            "Key Vault key decrypt/unwrapKey"
          ]
        }
      }
    },
    "CanExportKey": {
      "nature": "explicit"
    },
    "CanCreateKey": {
      "nature": "explicit"
    },
    "CanSignAs": {
      "nature": "explicit",
      "providers": {
        "gcp": {
          "permissions": [
            "iam.serviceAccounts.signBlob",
            "iam.serviceAccounts.signJwt"
          ]
        }
      }
    },
    "CanRetrieveToken": {
      "nature": "both"
    },
    "ExposesCredential": {
      "nature": "derived"
    },
    "CredentialsFor": {
      "nature": "explicit"
    },
    "CanRead": {
      "nature": "both"
    },
    "CanWrite": {
      "nature": "both"
    },
    "CanDelete": {
      "nature": "both"
    },
    "CanModify": {
      "nature": "both"
    },
    "CanAdminister": {
      "nature": "explicit"
    },
    "CanTakeOwnership": {
      "nature": "explicit"
    },
    "CanControl": {
      "nature": "derived"
    },
    "CanCreate": {
      "nature": "explicit"
    },
    "CanReplace": {
      "nature": "explicit"
    },
    "CanNetworkReach": {
      "nature": "derived",
      "conditions": [
        "network_reachability"
      ]
    },
    "CanReachPort": {
      "nature": "derived"
    },
    "RoutesTo": {
      "nature": "explicit"
    },
    "PeeredWith": {
      "nature": "explicit"
    },
    "ExposedToInternet": {
      "nature": "derived"
    },
    "ExposedToTenant": {
      "nature": "derived"
    },
    "ExposedToAccount": {
      "nature": "derived"
    },
    "PrivateReachability": {
      "nature": "derived"
    },
    "CanReadData": {
      "nature": "derived",
      "conditions": [
        "iam_permission",
        "resource_policy",
        "network_reachability",
        "key_permission"
      ]
    },
    "CanWriteData": {
      "nature": "derived"
    },
    "CanDeleteData": {
      "nature": "derived"
    },
    "CanExfiltrate": {
      "nature": "derived"
    },
    "ContainsSecret": {
      "nature": "explicit"
    },
    "ContainsCredential": {
      "nature": "explicit"
    },
    "ContainsResourceReference": {
      "nature": "explicit"
    },
    "CanEnterAccount": {
      "nature": "derived"
    },
    "CanEnterSubscription": {
      "nature": "derived"
    },
    "CanEnterProject": {
      "nature": "derived"
    },
    "CanEnterTenant": {
      "nature": "derived"
    },
    "CanEnterOrganization": {
      "nature": "derived"
    },
    "CrossAccountTrust": {
      "nature": "both"
    },
    "CrossTenantTrust": {
      "nature": "explicit"
    },
    "CrossProjectTrust": {
      "nature": "explicit"
    },
    "FederatesTo": {
      "nature": "explicit"
    },
    "CredentialValidFor": {
      "nature": "explicit"
    },
    "AuthenticatesTo": {
      "nature": "explicit"
    },
    "TrustsExternalIdentity": {
      "nature": "explicit"
    },
    "ExternalIdentityMapsTo": {
